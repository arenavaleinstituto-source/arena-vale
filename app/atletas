'use client';

import { useState, useEffect } from 'react';

interface Atleta {
  id: string;
  nome: string;
  categoria: string;
  equipe: string;
  imagem: string;
}

const ATLETAS_PADRAO: Atleta[] = [
  {
    id: '1',
    nome: 'Maurício Miranda',
    categoria: 'FUNDADOR',
    equipe: 'ARENA VALE SPORTS',
    imagem: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80'
  },
  {
    id: '2',
    nome: 'João Santos',
    categoria: 'FUTEBOL',
    equipe: 'AMIGOS FC',
    imagem: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80'
  },
  {
    id: '3',
    nome: 'Ana Oliveira',
    categoria: 'VÔLEI',
    equipe: 'RESENHA FC',
    imagem: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=600&q=80'
  }
];

export default function GestaoAtletasPage() {
  const [atletas, setAtletas] = useState<Atleta[]>([]);
  const [nome, setNome] = useState('');
  const [categoria, setCategoria] = useState('');
  const [equipe, setEquipe] = useState('');
  const [imagemPreview, setImagemPreview] = useState('');
  const [urlImagem, setUrlImagem] = useState('');

  // Carrega atletas do LocalStorage
  useEffect(() => {
    const salvos = localStorage.getItem('arena_vale_atletas');
    if (salvos) {
      try {
        setAtletas(JSON.parse(salvos));
      } catch {
        setAtletas(ATLETAS_PADRAO);
      }
    } else {
      setAtletas(ATLETAS_PADRAO);
    }
  }, []);

  // Salva no LocalStorage
  const salvarLista = (novaLista: Atleta[]) => {
    setAtletas(novaLista);
    localStorage.setItem('arena_vale_atletas', JSON.stringify(novaLista));
  };

  // Upload local de imagem via input file
  const handleUploadArquivo = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => {
        setImagemPreview(reader.result as string);
        setUrlImagem('');
      };
      reader.readAsDataURL(file);
    }
  };

  // Adicionar novo atleta
  const handleAdicionar = (e: React.FormEvent) => {
    e.preventDefault();
    const fotoFinal = imagemPreview || urlImagem;

    if (!nome.trim() || !categoria.trim() || !equipe.trim() || !fotoFinal) {
      alert('Por favor, preencha todos os campos e adicione uma foto.');
      return;
    }

    const novoAtleta: Atleta = {
      id: Date.now().toString(),
      nome,
      categoria: categoria.toUpperCase(),
      equipe,
      imagem: fotoFinal
    };

    const atualizados = [novoAtleta, ...atletas];
    salvarLista(atualizados);

    // Limpar formulário
    setNome('');
    setCategoria('');
    setEquipe('');
    setImagemPreview('');
    setUrlImagem('');
  };

  // Excluir atleta
  const handleExcluir = (id: string) => {
    if (confirm('Tem certeza de que deseja remover este atleta em destaque?')) {
      const atualizados = atletas.filter((a) => a.id !== id);
      salvarLista(atualizados);
    }
  };

  return (
    <main className="min-h-screen bg-[#071426] text-white">
      {/* Topo / Cabeçalho */}
      <header className="mx-auto flex max-w-7xl items-center justify-between border-b border-white/10 px-6 py-6">
        <div>
          <span className="text-xs font-bold tracking-[.25em] text-[#d4a849]">PAINEL DE DESTAQUES</span>
          <h1 className="text-2xl font-black uppercase sm:text-3xl">ATLETAS EM DESTAQUE</h1>
        </div>
        <a
          href="/"
          className="rounded-full border border-white/20 px-5 py-2.5 text-xs font-bold transition hover:bg-white/10"
        >
          ← VOLTAR AO INÍCIO
        </a>
      </header>

      <div className="mx-auto max-w-7xl px-6 py-10">
        {/* Formulário de Cadastro */}
        <section className="mb-14 rounded-3xl border border-white/10 bg-[#0e2148] p-6 sm:p-8">
          <h2 className="text-xl font-black uppercase text-[#d4a849]">Cadastrar Novo Atleta Destaque</h2>
          <p className="mt-1 text-sm text-[#a8b4cc]">Adicione novos talentos com foto para serem exibidos na lista.</p>

          <form onSubmit={handleAdicionar} className="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <div>
              <label className="mb-1.5 block text-xs font-bold tracking-wider text-[#a8b4cc]">NOME DO ATLETA</label>
              <input
                type="text"
                placeholder="Ex: Carlos Eduardo"
                value={nome}
                onChange={(e) => setNome(e.target.value)}
                className="w-full rounded-xl border border-white/10 bg-[#071426] px-4 py-3 text-sm text-white outline-none focus:border-[#d4a849]"
                required
              />
            </div>

            <div>
              <label className="mb-1.5 block text-xs font-bold tracking-wider text-[#a8b4cc]">MODALIDADE / CATEGORIA</label>
              <input
                type="text"
                placeholder="Ex: FUTEBOL, VÔLEI, FUNDADOR..."
                value={categoria}
                onChange={(e) => setCategoria(e.target.value)}
                className="w-full rounded-xl border border-white/10 bg-[#071426] px-4 py-3 text-sm text-white outline-none focus:border-[#d4a849]"
                required
              />
            </div>

            <div>
              <label className="mb-1.5 block text-xs font-bold tracking-wider text-[#a8b4cc]">EQUIPE / CLUBE</label>
              <input
                type="text"
                placeholder="Ex: ARENA VALE SPORTS"
                value={equipe}
                onChange={(e) => setEquipe(e.target.value)}
                className="w-full rounded-xl border border-white/10 bg-[#071426] px-4 py-3 text-sm text-white outline-none focus:border-[#d4a849]"
                required
              />
            </div>

            {/* Upload ou URL da Foto */}
            <div className="sm:col-span-2 lg:col-span-2">
              <label className="mb-1.5 block text-xs font-bold tracking-wider text-[#a8b4cc]">
                FOTO DO ATLETA (ESCOLHA UM ARQUIVO DO DISPOSITIVO OU COLE UM LINK)
              </label>
              <div className="grid gap-3 sm:grid-cols-2">
                <input
                  type="file"
                  accept="image/*"
                  onChange={handleUploadArquivo}
                  className="w-full rounded-xl border border-white/10 bg-[#071426] px-3 py-2 text-xs text-[#a8b4cc] file:mr-3 file:rounded-lg file:border-0 file:bg-[#d4a849] file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-[#071426]"
                />
                <input
                  type="url"
                  placeholder="Ou cole o link da foto (https://...)"
                  value={urlImagem}
                  onChange={(e) => {
                    setUrlImagem(e.target.value);
                    setImagemPreview('');
                  }}
                  className="w-full rounded-xl border border-white/10 bg-[#071426] px-4 py-3 text-sm text-white outline-none focus:border-[#d4a849]"
                />
              </div>
            </div>

            {/* Botão Salvar */}
            <div className="flex items-end">
              <button
                type="submit"
                className="w-full rounded-xl bg-[#d4a849] py-3.5 text-sm font-black uppercase text-[#071426] transition hover:bg-[#e0b75a]"
              >
                + Adicionar Atleta
              </button>
            </div>
          </form>
        </section>

        {/* Galeria de Atletas */}
        <section>
          <div className="mb-6 flex items-center justify-between">
            <h2 className="text-2xl font-black uppercase tracking-tight">Atletas Cadastrados ({atletas.length})</h2>
          </div>

          <div className="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            {atletas.map((atleta) => (
              <article
                key={atleta.id}
                className="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-[#10275a] shadow-lg transition hover:border-[#d4a849]/50"
              >
                {/* Imagem do Atleta */}
                <div className="relative h-64 w-full overflow-hidden bg-[#071426]">
                  <img
                    src={atleta.imagem}
                    alt={atleta.nome}
                    className="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-[#10275a] via-transparent to-transparent" />
                </div>

                {/* Dados */}
                <div className="p-6">
                  <span className="text-xs font-bold tracking-wider text-[#d4a849]">
                    ⭐ {atleta.categoria}
                  </span>
                  <h3 className="mt-2 text-2xl font-black leading-tight text-white">{atleta.nome}</h3>
                  <p className="mt-1 text-sm text-[#a8b4cc]">{atleta.equipe}</p>

                  {/* Botão de Excluir */}
                  <button
                    onClick={() => handleExcluir(atleta.id)}
                    className="mt-6 flex w-full items-center justify-center gap-2 rounded-xl border border-red-500/30 bg-red-500/10 py-2.5 text-xs font-bold text-red-400 transition hover:bg-red-500 hover:text-white"
                  >
                    🗑️ Excluir Atleta
                  </button>
                </div>
              </article>
            ))}
          </div>

          {atletas.length === 0 && (
            <div className="rounded-3xl border border-dashed border-white/20 p-12 text-center text-[#a8b4cc]">
              Nenhum atleta cadastrado no momento. Preencha o formulário acima para adicionar.
            </div>
          )}
        </section>
      </div>
    </main>
  );
}
