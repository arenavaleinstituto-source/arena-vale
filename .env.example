# ═══════════════════════════════════════════════════════════════════════
#  ARENA VALE — VARIÁVEIS DE AMBIENTE
# ═══════════════════════════════════════════════════════════════════════
#  Copie para `.env.local` e preencha. NUNCA versione o `.env.local`.
#
#  cp .env.example .env.local
#
#  No Vercel: Project Settings → Environment Variables.
#  As duas variáveis abaixo precisam estar disponíveis em PRODUÇÃO,
#  PREVIEW e DEVELOPMENT — a variável NEXT_PUBLIC_* é embutida no bundle
#  do navegador no momento do build.
# ═══════════════════════════════════════════════════════════════════════

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon) do Supabase — é pública por definição e vai para o
# navegador. As regras RLS do banco são a proteção real dos dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# Chave de serviço (service_role) — SOMENTE no servidor.
# Nunca exponha com NEXT_PUBLIC_ e nunca use no cliente.
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
